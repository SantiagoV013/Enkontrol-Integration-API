HOST=127.0.0.1
PORT=4080
APPS_FILE=./apps.local.json
# Separate integration database; never the ERP database or source CRM database.
HUB_MONGODB_URI=mongodb://127.0.0.1:27017
HUB_MONGODB_DB=enkontrol_integration
CRM_MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/
CRM_MONGODB_DB=crm_construkom
# Generate a different random secret per app, at least 32 characters.
CRM_API_KEY=replace-with-a-random-secret-at-least-32-characters
SYNC_MODE=preview
POLL_SECONDS=30
# System DSN on Windows, matching the bitness of Node.js and the SQL Anywhere driver.
EK_ODBC_CONNECTION_STRING=DSN=EnkontrolTest;UID=INTEGRATION_USER;PWD=LOCAL_SECRET
EK_EXPECTED_SERVER=test_ck
EK_EXPECTED_DATABASE=EK_ADM01_11
# Fill the exact File property verified by your ERP administrator, required for live writes.
EK_EXPECTED_FILE=
# Enable only after the stored procedure contract is implemented and tested in the test ERP.
EK_WRITES_ENABLED=false
